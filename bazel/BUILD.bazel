exports_files(glob(["*.py", "*.sh"]))

# Re-exported under the main repository so the -sys crates' build scripts can name them.
alias(
    name = "libclang",
    actual = "@llvm_toolchain_llvm//:libclang",
    visibility = ["//visibility:public"],
)

alias(
    name = "clang",
    actual = "@llvm_toolchain_llvm//:bin/clang",
    visibility = ["//visibility:public"],
)

alias(
    name = "clang_includes",
    actual = "@llvm_toolchain_llvm//:include",
    visibility = ["//visibility:public"],
)

# Linux only: bindgen asks a `clang` for the header search path, and a remote executor has none;
# on macOS the host's clang pairs with the SDK.
genrule(
    name = "bindgen_env",
    outs = ["bindgen.env"],
    cmd = select({
        "@platforms//os:linux": "echo 'CLANG_PATH=$${pwd}/external/toolchains_llvm++llvm+llvm_toolchain_llvm/bin/clang' > $@",
        "//conditions:default": "touch $@",
    }),
    visibility = ["//visibility:public"],
)
