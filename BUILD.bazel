load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml", "Cargo.lock"])

# The files src/ embeds with include_str!/include_bytes!.
EMBEDDED = glob([
    "runtime/**",
    "e2e/*.js",
    "e2e/package-lock.json",
])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    crate_root = "build.rs",
    data = glob(["runtime/ruby/**", "runtime/spinel/**"]),
    edition = "2024",
)

rust_library(
    name = "roundhouse_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = EMBEDDED,
    crate_name = "roundhouse",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [":build_script"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "roundhouse",
    srcs = ["src/bin/roundhouse.rs"],
    compile_data = EMBEDDED,
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":roundhouse_lib"] + all_crate_deps(normal = True),
)

# The blog fixture is generated (bin/rh fixture), not checked in; its files are inputs here.
filegroup(
    name = "real_blog",
    srcs = glob(
        ["fixtures/real-blog/**"],
        exclude = [
            "fixtures/real-blog/tmp/**",
            "fixtures/real-blog/log/**",
            "fixtures/real-blog/storage/**",
            "fixtures/real-blog/node_modules/**",
            "fixtures/real-blog/.bundle/**",
            "fixtures/real-blog/**/* *",
        ],
        allow_empty = True,
    ),
)

# One emit + one test per target: a test whose emitted project is
# byte-identical to a cached run is not re-run.
[genrule(
    name = "emit_blog_%s" % target,
    srcs = [":real_blog"],
    outs = ["blog-%s.tar" % target],
    cmd = "$(location :roundhouse) --target %s -o $(RULEDIR)/blog-%s fixtures/real-blog >/dev/null && " % (target, target) +
          "python3 $(location //bazel:pack.py) $(RULEDIR)/blog-%s $@" % target,
    tools = [":roundhouse", "//bazel:pack.py"],
) for target in ["rust", "kotlin", "swift"]]

# The image each target's toolchain comes from when the test runs on a remote executor.
TEST_IMAGES = {
    "rust": "docker://rust:1.98.1",
    "kotlin": "docker://gradle:9.5.1-jdk21",
    "swift": "docker://swift:6.1",
}

[sh_test(
    name = "blog_%s_test" % target,
    srcs = ["//bazel:test_%s.sh" % target],
    args = ["$(location :emit_blog_%s)" % target],
    data = [":emit_blog_%s" % target],
    exec_properties = {
        "container-image": TEST_IMAGES[target],
        # The toolchains resolve the emitted project's dependencies from their registries.
        "network": "external",
    },
    tags = ["requires-network"],
    timeout = "long",
) for target in ["rust", "kotlin", "swift"]]

# The fixture as Rails serves it: its seeded DB included.
genrule(
    name = "real_blog_tar",
    srcs = [":real_blog", "fixtures/real-blog/storage/development.sqlite3"],
    outs = ["real-blog.tar"],
    cmd = "python3 $(location //bazel:pack.py) fixtures/real-blog $@",
    tools = ["//bazel:pack.py"],
)

sh_test(
    name = "compare_rust_test",
    srcs = ["//bazel:compare_rust.sh"],
    args = [
        "$(rootpath :real_blog_tar)",
        "$(rootpath :emit_blog_rust)",
        "$(rootpath //tools/compare:roundhouse-compare)",
    ],
    data = [":real_blog_tar", ":emit_blog_rust", "//tools/compare:roundhouse-compare"],
    exec_properties = {
        "container-image": "docker://ruby:3.4",
        "network": "external",
    },
    tags = ["requires-network"],
    timeout = "long",
)

# What the test suites read from the repository, relative to its root.
TEST_DATA = glob(
    [
        "*",
        "fixtures/**",
        "tests/**",
        "runtime/**",
        "e2e/**",
        "docs/**",
        "scripts/**",
        "bin/**",
        "assets/**",
        "site/**",
        "wasm/**",
        "tools/**",
        "editors/**",
        "bench/**",
        "kotlin-reference/**",
        "swift-reference/**",
    ],
    exclude = [
        "**/node_modules/**",
        "**/tmp/**",
        "**/log/**",
        "**/target/**",
        "**/.bundle/**",
        "**/* *",
        "bazel-*/**",
    ],
    allow_empty = True,
)

# .cargo/config.toml's [env]: the analyzer's recursive walkers need more than a test thread's default stack.
TEST_ENV = {"RUST_MIN_STACK": "33554432"}

# Remotely, the suites run in an image with Ruby: some drive the emitted Ruby tree.
UNIT_EXEC = {"container-image": "docker://ruby:3.4"}

rust_test(
    name = "lib_test",
    crate = ":roundhouse_lib",
    data = TEST_DATA,
    env = TEST_ENV,
    exec_properties = UNIT_EXEC,
    tags = ["unit"],
)

[rust_test(
    name = "test_" + f[len("tests/"):-len(".rs")],
    srcs = glob(["tests/**/*.rs"]),
    crate_root = f,
    data = TEST_DATA + [":roundhouse"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_roundhouse": "$(rootpath :roundhouse)"},
    compile_data = EMBEDDED + glob(["tests/**"], exclude = ["tests/**/*.rs"]),
    env = TEST_ENV,
    exec_properties = UNIT_EXEC,
    tags = ["unit"],
    deps = [":roundhouse_lib"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
) for f in glob(["tests/*.rs"])]
