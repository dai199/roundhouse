module ActiveSupport
  class OrderedOptions
    @values: Hash[untyped, untyped]
    @default: untyped

    def initialize: (?untyped default) -> void
    def []: (String | Symbol key) -> untyped
    def []=: (String | Symbol key, untyped value) -> untyped
    def merge!: (Hash[untyped, untyped] other) -> OrderedOptions
    def update: (Hash[untyped, untyped] other) -> OrderedOptions
    def keys: () -> Array[untyped]
    def key?: (untyped key) -> bool
    def fetch: (untyped key, *untyped default) ?{ (untyped) -> untyped } -> untyped
    def to_h: () -> Hash[untyped, untyped]
    def empty?: () -> bool
    def method_missing: (Symbol name, *untyped args) -> untyped
    def respond_to_missing?: (Symbol _name, bool _include_private) -> bool
  end
end
