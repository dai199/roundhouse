class SafeString < String
  def html_safe?: () -> bool
  def html_safe: () -> SafeString
  def to_s: () -> SafeString
  def +: (untyped other) -> SafeString
  def <<: (untyped other) -> SafeString
  def concat: (untyped other) -> SafeString
  def safe_concat: (untyped other) -> SafeString
end

class String
  def html_safe: () -> SafeString
  def html_safe?: () -> bool
end
