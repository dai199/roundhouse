module(name = "roundhouse")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
# These crates' build scripts read their vendored trees through a compile-time
# CARGO_MANIFEST_DIR, which is the compile sandbox under Bazel; the patches
# read it at run time instead.
[crate.annotation(
    build_script_data_glob = ["**"],
    compile_data_glob = ["**"],
    crate = name,
    patch_args = ["-p1"],
    patches = ["//bazel/patches:%s-build.patch" % name],
) for name in ["ruby-rbs", "ruby-rbs-sys", "ruby-prism", "ruby-prism-sys"]]

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")
